{
  "expo": {
    "name": "ForwardService",
    "slug": "forward-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "forwardservice",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fwdford.forwardservice"
    },
    "android": {
      "package": "com.fwdford.forwardservice",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
