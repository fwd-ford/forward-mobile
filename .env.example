# Optional overrides for app.config.js (all keys are OPTIONAL).
# Without a .env the app talks to the Fly.io API over HTTPS and offers the
# offline "Modo demonstracao" when the server is unreachable.
#
# Override only when running forward-api-java locally
# (./mvnw spring-boot:run -Dspring-boot.run.profiles=demo):
#   EXPO_PUBLIC_API_URL=http://localhost:8080    # web / iOS simulator
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8080     # Android emulator (build with ALLOW_HTTP=1)
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:8080  # physical device on the same LAN (ALLOW_HTTP=1)

EXPO_PUBLIC_API_URL=
ALLOW_HTTP=
